<?xml version="1.0" encoding="UTF-8"?>
<gui name="dataexplorer"
     version="11"
     xmlns="https://www.kde.org/standards/kxmlgui/1.0"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="https://www.kde.org/standards/kxmlgui/1.0
                         https://www.kde.org/standards/kxmlgui/1.0/kxmlgui.xsd">
  <MenuBar>
    <Menu name="file" >
      <text>File</text>
      <Action name="open_loose" />
      <Separator />
      <Action name="import_list" />
      <Action name="download_list" />
      <Separator/>
      <Action name="manual_add" />
      <Separator/>
      <Action name="file_quit"/>
    </Menu>
    <Action name="file_actions" >
    </Action>
    <Menu name="edit" >
      <text>Edit</text>
      <Action name="search" />
      <Action name="go_to_path" />
    </Menu>
    <Menu name="view" >
      <text>View</text>
      <Action name="show_unknown" />
    </Menu>
    <Menu name="settings">
      <Action name="window_color_scheme"/>
    </Menu>
  </MenuBar>
  <ToolBar name="mainToolBar" >
    <text>Main Toolbar</text>
    <Action name="go_back" />
    <Action name="go_forward" />
  </ToolBar>
</gui>
